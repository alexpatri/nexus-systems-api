{
  "name": "operators",
  "description": "Semântica de cada operador e os erros do avaliador. Números são IEEE 754 de 64 bits; div não arredonda; sub e div têm dois operandos, ceil e floor um, os demais um ou mais. Os filhos são avaliados da esquerda para a direita, depois de conferida a aridade.",
  "cases": [
    {"name": "número", "expr": 7, "want": 7},
    {"name": "número fracionário", "expr": 0.5, "want": 0.5},
    {"name": "referência", "expr": {"ref": "attr.bod"}, "env": {"attr.bod": 4}, "want": 4},
    {"name": "add com vários operandos", "expr": {"op": "add", "of": [1, 2, 3]}, "want": 6},
    {"name": "add com um operando", "expr": {"op": "add", "of": [5]}, "want": 5},
    {"name": "sub", "expr": {"op": "sub", "of": [10, 3]}, "want": 7},
    {"name": "sub negativo", "expr": {"op": "sub", "of": [3, 10]}, "want": -7},
    {"name": "mul", "expr": {"op": "mul", "of": [2, 3, 4]}, "want": 24},
    {"name": "div não arredonda", "expr": {"op": "div", "of": [7, 2]}, "want": 3.5},
    {"name": "ceil de fração", "expr": {"op": "ceil", "of": [{"op": "div", "of": [7, 3]}]}, "want": 3},
    {"name": "ceil de inteiro", "expr": {"op": "ceil", "of": [4]}, "want": 4},
    {"name": "ceil de negativo", "expr": {"op": "ceil", "of": [-3.5]}, "want": -3},
    {"name": "floor de fração", "expr": {"op": "floor", "of": [{"op": "div", "of": [7, 2]}]}, "want": 3},
    {"name": "floor de negativo", "expr": {"op": "floor", "of": [-3.5]}, "want": -4},
    {"name": "min", "expr": {"op": "min", "of": [4, 2, 9]}, "want": 2},
    {"name": "max", "expr": {"op": "max", "of": [4, 2, 9]}, "want": 9},
    {"name": "referência com ponto no nome", "expr": {"op": "floor", "of": [{"op": "div", "of": [{"ref": "karma.total"}, 10]}]}, "env": {"karma.total": 57}, "want": 5},
    {"name": "referência fracionária", "expr": {"op": "ceil", "of": [{"ref": "attr.ess"}]}, "env": {"attr.ess": 5.25}, "want": 6},
    {"name": "referência ausente", "expr": {"op": "add", "of": [{"ref": "attr.bod"}, 1]}, "env": {}, "error": "missingRef"},
    {"name": "operador desconhecido", "expr": {"op": "pow", "of": [2, 3]}, "error": "unknownOp"},
    {"name": "sub com três operandos", "expr": {"op": "sub", "of": [3, 2, 1]}, "error": "arity"},
    {"name": "div com um operando", "expr": {"op": "div", "of": [3]}, "error": "arity"},
    {"name": "ceil com dois operandos", "expr": {"op": "ceil", "of": [1, 2]}, "error": "arity"},
    {"name": "add sem operandos", "expr": {"op": "add", "of": []}, "error": "arity"},
    {"name": "div por zero", "expr": {"op": "div", "of": [1, {"op": "sub", "of": [2, 2]}]}, "error": "divByZero"},
    {"name": "operação sem of", "expr": {"op": "add"}, "error": "malformed"},
    {"name": "of que não é lista", "expr": {"op": "add", "of": 3}, "error": "malformed"},
    {"name": "ref e op juntos", "expr": {"ref": "attr.bod", "op": "add", "of": [1]}, "env": {"attr.bod": 1}, "error": "malformed"},
    {"name": "ref que não é texto", "expr": {"ref": 3}, "error": "malformed"},
    {"name": "texto no lugar de número", "expr": {"op": "add", "of": ["3"]}, "error": "malformed"},
    {"name": "booleano no lugar de número", "expr": {"op": "add", "of": [true]}, "error": "malformed"},
    {"name": "nulo", "expr": null, "error": "malformed"}
  ]
}
